@model JACO.CR.Web.Models.ChangeRequestListViewModel
@{
    ViewData["Title"] = "Change Requests";
    string StatusClass(string status) => status switch
    {
        "Draft" => "status draft",
        "Pending Approval" => "status pending",
        "Completed" => "status completed",
        "Rejected" => "status rejected",
        "Sent Back" => "status sentback",
        _ => "status"
    };
    string PriorityClass(string priority) => priority switch
    {
        "High" => "jaco-badge jaco-badge-danger",
        "Medium" => "jaco-badge jaco-badge-warning",
        "Low" => "jaco-badge jaco-badge-success",
        _ => "jaco-badge jaco-badge-neutral"
    };

    string SortUrl(string field)
    {
        var dir = Model.Sort == field && Model.Dir == "asc" ? "desc" : "asc";
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Search)) qs.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (!string.IsNullOrWhiteSpace(Model.Status)) qs.Add($"status={Uri.EscapeDataString(Model.Status)}");
        if (!string.IsNullOrWhiteSpace(Model.Department)) qs.Add($"department={Uri.EscapeDataString(Model.Department)}");
        qs.Add($"sort={field}");
        qs.Add($"dir={dir}");
        return Model.BasePath + "?" + string.Join("&", qs);
    }
    string SortArrow(string field) => Model.Sort != field ? "" : (Model.Dir == "asc" ? " &#9650;" : " &#9660;");
}

<div class="jaco-page-header">
    <div>
        <h1>@(Model.IsAdminView ? "All Change Requests" : "Change Requests")</h1>
        <p>@(Model.IsAdminView ? "Every change request in the system, across every requestor." : "Create, track and manage your change requests.")</p>
    </div>
    @if (!Model.IsAdminView)
    {
        <a class="jaco-btn jaco-btn-primary" href="/ChangeRequest/Create">+ New Change Request</a>
    }
</div>

<div class="jaco-stat-grid">
    <a class="jaco-card jaco-stat-card @(string.IsNullOrEmpty(Model.Status) ? "jaco-stat-active" : "")" style="text-decoration:none;" href="@Model.BasePath?status=&department=@Model.Department&search=@Model.Search">
        <div class="jaco-stat-icon" style="background:var(--jaco-info-bg);color:var(--jaco-info);"><span class="jaco-icon jaco-icon-docs"></span></div>
        <div><div class="jaco-stat-value">@Model.TotalCount</div><div class="jaco-stat-label">Total</div></div>
    </a>
    <a class="jaco-card jaco-stat-card @(Model.Status == "Draft" ? "jaco-stat-active" : "")" style="text-decoration:none;" href="@Model.BasePath?status=Draft&department=@Model.Department&search=@Model.Search">
        <div class="jaco-stat-icon" style="background:#eef0f3;color:var(--jaco-text-muted);"><span class="jaco-icon jaco-icon-edit"></span></div>
        <div><div class="jaco-stat-value">@Model.DraftCount</div><div class="jaco-stat-label">Draft</div></div>
    </a>
    <a class="jaco-card jaco-stat-card @(Model.Status == "Pending Approval" ? "jaco-stat-active" : "")" style="text-decoration:none;" href="@Model.BasePath?status=Pending Approval&department=@Model.Department&search=@Model.Search">
        <div class="jaco-stat-icon" style="background:var(--jaco-warning-bg);color:var(--jaco-warning);"><span class="jaco-icon jaco-icon-clock"></span></div>
        <div><div class="jaco-stat-value">@Model.PendingApprovalCount</div><div class="jaco-stat-label">Pending Approval</div></div>
    </a>
    <a class="jaco-card jaco-stat-card @(Model.Status == "Completed" ? "jaco-stat-active" : "")" style="text-decoration:none;" href="@Model.BasePath?status=Completed&department=@Model.Department&search=@Model.Search">
        <div class="jaco-stat-icon" style="background:var(--jaco-success-bg);color:var(--jaco-success);"><span class="jaco-icon jaco-icon-check-circle"></span></div>
        <div><div class="jaco-stat-value">@Model.CompletedCount</div><div class="jaco-stat-label">Completed</div></div>
    </a>
</div>

<form method="get" action="@Model.BasePath" style="display:flex;gap:12px;margin-bottom:14px;align-items:center;">
    <input type="text" name="search" value="@Model.Search" class="jaco-input" style="margin:0;max-width:340px;" placeholder="Search by CR number, title, department&hellip;" />
    <select name="department" class="jaco-select" style="width:auto;margin:0;" onchange="this.form.submit()">
        <option value="">All Departments</option>
        @foreach (var d in Model.Departments)
        {
            <option value="@d.Value" selected="@(Model.Department == d.Value)">@d.DisplayText</option>
        }
    </select>
    <input type="hidden" name="status" value="@Model.Status" />
    <button type="submit" class="jaco-btn jaco-btn-outline">Search</button>
</form>

<div class="lookup-tabs" style="margin-bottom:16px;">
    @foreach (var (value, label) in JACO.CR.Web.Models.ChangeRequestListViewModel.StatusTabs)
    {
        <a class="lookup-tab @(Model.Status == value ? "selected" : "")"
           href="@Model.BasePath?status=@value&department=@Model.Department&search=@Model.Search">@label</a>
    }
</div>

<div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
    <a class="jaco-btn jaco-btn-outline jaco-btn-sm" href="@Model.ExportPath?status=@Model.Status&department=@Model.Department&search=@Model.Search">Download CSV</a>
</div>
<div class="jaco-card">
    <table class="jaco-table">
        <thead><tr>
            <th><a class="link" href="@SortUrl("CRNumber")">CR No.@(Html.Raw(SortArrow("CRNumber")))</a></th>
            <th><a class="link" href="@SortUrl("Title")">Title@(Html.Raw(SortArrow("Title")))</a></th>
            <th><a class="link" href="@SortUrl("Department")">Department@(Html.Raw(SortArrow("Department")))</a></th>
            <th><a class="link" href="@SortUrl("Priority")">Priority@(Html.Raw(SortArrow("Priority")))</a></th>
            <th><a class="link" href="@SortUrl("Status")">Status@(Html.Raw(SortArrow("Status")))</a></th>
            @if (Model.IsAdminView)
            {
                <th>Created By</th>
            }
            <th><a class="link" href="@SortUrl("CreatedAt")">@(Model.IsAdminView ? "Created On" : "Submitted On")@(Html.Raw(SortArrow("CreatedAt")))</a></th>
        </tr></thead>
        <tbody>
        @foreach (var x in Model.Rows)
        {
            <tr>
                <td><a class="link" href="/ChangeRequest/Details/@x.Id">@x.CRNumber</a></td>
                <td>@x.Title</td>
                <td>@x.Department</td>
                <td><span class="@PriorityClass(x.Priority)">@x.Priority</span></td>
                <td><span class="@StatusClass(x.Status)">@x.Status</span></td>
                @if (Model.IsAdminView)
                {
                    <td>@x.CreatorUserName</td>
                }
                <td>@x.CreatedAt.ToString("dd MMM yyyy")</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="@(Model.IsAdminView ? 7 : 6)" style="text-align:center;color:var(--jaco-text-muted);">No change requests match this filter.</td></tr>
        }
        </tbody>
    </table>
</div>
